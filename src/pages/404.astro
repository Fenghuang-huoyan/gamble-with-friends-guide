---
import BaseLayout from '@framework/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found — Gamble With Your Friends Wiki"
  description="That page is not on this wiki. Try the beginner guide, achievements, endings, or online fix."
>
  <main id="content" class="shell section">
    <p class="kicker">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">This wiki is a short set of answers, not a pile of platform URLs. Start from the problem you actually have.</p>
    <ul class="related">
      <li><a href="/">Home</a></li>
      <li><a href="/beginner-guide">Beginner guide</a></li>
      <li><a href="/achievements">Achievements</a></li>
      <li><a href="/endings">Endings</a></li>
      <li><a href="/online-fix">Online fix</a></li>
    </ul>
  </main>
</BaseLayout>
