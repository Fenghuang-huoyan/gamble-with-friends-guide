---
import { adsConfig, resolveAdPlacement } from '@site/ads.config';

interface Props {
  name: keyof typeof adsConfig.slots;
  variant?: 'inline' | 'sidebar' | 'footer';
}
const { name, variant = 'inline' } = Astro.props;
const placement = resolveAdPlacement(name);
---
{placement.active ? (
  <aside class:list={['ad-slot', variant === 'sidebar' && 'ad-sidebar']} aria-label="Advertisement" data-slot={name}>
    <p class="tiny">Advertisement</p>
    <script is:inline async="async" data-cfasync="false" src={placement.scriptSrc}></script>
    <div id={placement.containerId}></div>
  </aside>
) : null}
<style>
  .ad-slot { margin: 1rem 0; min-height: 0; }
  .ad-sidebar { display: none; }
  @media (min-width: 1040px) {
    .ad-sidebar { display: block; }
  }
</style>
