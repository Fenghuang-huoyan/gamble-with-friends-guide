---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2);
---
{items.length > 0 && (
  <nav class="toc" aria-label="On this page">
    <p>On this page</p>
    <ol>
      {items.map((item) => (
        <li><a href={`#${item.slug}`}>{item.text}</a></li>
      ))}
    </ol>
  </nav>
)}
