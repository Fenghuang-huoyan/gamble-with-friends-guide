{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@framework/*": ["framework/*"],
      "@site/*": ["sites/active/*"],
      "@content/*": ["content/gwyf/*"]
    }
  }
}
